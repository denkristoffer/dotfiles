# https://scottspence.com/posts/speeding-up-my-zsh-shell#fixing-the-completion-system-3076--10
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' $ZSH_COMPDUMP 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

# Homebrew
if [[ $(sysctl -n machdep.cpu.brand_string) == "Apple M"* ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Spaceship prompt -- https://github.com/spaceship-prompt/spaceship-prompt
source $(brew --prefix)/opt/spaceship/spaceship.zsh

# Work around https://github.com/mafredri/zsh-async/issues/70 ("No handler
# installed for fd N"): only remove the ZLE handler if one is installed.
async_stop_worker() {
  setopt localoptions noshwordsplit

  local ret=0 worker k v
  for worker in $@; do
    for k v in ${(@kv)ASYNC_PTYS}; do
      if [[ $v == $worker ]]; then
        zle -F -L $k &>/dev/null && zle -F $k
        unset "ASYNC_PTYS[$k]"
      fi
    done
    async_unregister_callback $worker
    zpty -d $worker 2>/dev/null || ret=$?

    typeset -gA ASYNC_PROCESS_BUFFER
    unset "ASYNC_PROCESS_BUFFER[$worker]"
  done

  return $ret
}

# Spaceship restarts its async worker on every prompt, and each start needs a
# new pseudo terminal. When none can be opened (e.g. when the system-wide
# kern.tty.ptmx_max limit is exhausted), upstream still evals in the missing
# worker and prints errors on every prompt. Fall back to rendering the prompt
# synchronously instead, and retry the worker on the next prompt.
typeset -gi _spaceship_worker_unavailable=0

spaceship::worker::init() {
  if (( _spaceship_worker_unavailable )); then
    _spaceship_worker_unavailable=0
    SPACESHIP_PROMPT_ASYNC=true
  fi
  spaceship::is_prompt_async || return

  SPACESHIP_JOBS=()
  async_stop_worker "spaceship"
  if ! async_start_worker "spaceship" -n -u 2>/dev/null; then
    _spaceship_worker_unavailable=1
    SPACESHIP_PROMPT_ASYNC=false
    return
  fi
  # setopt before call register to avoid callback by async_worker_eval
  async_worker_eval "spaceship" setopt extendedglob
  async_worker_eval "spaceship" spaceship::worker::renice
  async_register_callback "spaceship" spaceship::core::async_callback
}

# z -- https://github.com/rupa/z
source $(brew --prefix)/etc/profile.d/z.sh

# zsh-autosuggestions -- https://github.com/zsh-users/zsh-autosuggestions
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# zsh-history-substring-search -- https://github.com/zsh-users/zsh-history-substring-search
source $(brew --prefix)/share/zsh-history-substring-search/zsh-history-substring-search.zsh
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# fnm
eval "$(fnm env)"

# mise
eval "$(mise activate zsh)"

# omp
if command -v omp >/dev/null 2>&1; then
  eval "$(omp completions zsh)"
fi

# zsh-syntax-highlighting -- https://github.com/zsh-users/zsh-syntax-highlighting
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi
